<!doctype html>
<html>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css"/>
  <body class=" bg-gray-800">
    <div
      style="align-self: first baseline;"
      class="px-2 mx-2 sm:shadow-2xl sm:shadow-gray-950 rounded-4xl p-10"
    >
      <h1 class="text-gray-400 text-3xl font-bold" style="text-align-last: end;">BentStyx Custom Rods
        <span
          class="font-extralight text-gray-400 italic text-sm mt-32 p-0"
          style="display: ruby-text-container; font-size: 12px;"
        >
          <br>By: Ruben Rodriguez</span></h1>
      <p class="text-gray-400 text-center italic text-sm font-light">About Me:
        <span class="font-extralight italic">
          I am retired and following my passion of fishing and craftsmanship to
          bring you the best fishing experience possible!</span></p>
      <div class="px-2 py-2 mx-2 text-gray-400 text-center">
        <%= image_tag "DSC_4012.JPG", alt: "rod1", class: "rounded-4xl" %>
        <p class="">Handcrafted</p>
      </div>
      <button
        class="
          bg-gray-500 hover:mt-4 hover:bg-gray-100 hover:text-black hover:animate-bounce
          rounded-4xl ml-16 mt-4 px-2 py-2 text-white
        "
        type="button"
      >Order yours now!</button>
    </div>
    <div
      class="
        px-2 mx-2 p-10 text-center rounded-4xl sm:shadow-2xl sm:drop-shadow-gray-950
        sm:shadow-gray-950 justify-items-center sm:grid sm:grid-cols-3 sm:gap-2
        text-gray-400
      "
    >
      <div class="col-span-3 image_wrapper">
        <%= image_tag "DSC_3926.JPG", alt: "rod2", class: "rounded-4xl image_tag" %>
        <svg viewBox="0 0 400 600">
          <%= link_to product_path(2) do %>
            <rect
              x="180"
              width="120"
              height="900"
              opacity="0"
              fill="transparent"
              class="middle-rod-rect"
            />
          <% end %>
          <%= link_to product_path(3) do %>
            <rect
              x="300"
              width="100"
              height="900"
              opacity="0"
              fill="transparent"
              class="right-rod-rect"
            />
          <% end %>
          <%= link_to product_path(1) do %>
            <rect
              fill="transparent"
              opacity="0"
              width="175"
              height="900"
              class="left-rod-rect"
            />
          <% end %>
        </svg>
        <p style="text-gray-400">Makes for An Excellent Gift for your Beloved Fisherman!</p>
      </div>
    </div>
  </body>
</html>
