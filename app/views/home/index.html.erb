<!doctype html>
<html>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css"/>
  <body class=" bg-sky-950">
    <div
      style="align-self: first baseline;"
      class="px-2 mx-2 sm:shadow-2xl sm:shadow-gray-950 rounded-4xl p-10"
    >
      <h1 class="text-blue-500 text-3xl font-bold" style="text-align-last: end;">BentStyx Custom Rods
        <span
          class="font-extralight text-teal-200 italic text-sm mt-32 p-0"
          style="display: ruby-text-container; font-size: 12px;"
        >
          <br>By: Ruben Rodriguez</span></h1>
      <p class="text-teal-400 text-center italic text-sm font-light">About Me:
        <span class="font-extralight italic">
          I am retired and following my passion of fishing and craftsmanship to
          bring you the best fishing experience possible!</span></p>
      <div class="px-2 py-2 mx-2 text-teal-300 text-center">
        <%= image_tag "DSC_4012.JPG", alt: "rod1", class: "rounded-4xl" %>
        <p class="">Handcrafted</p>
      </div>
      <button
        class="
          bg-sky-500 hover:mt-4 hover:bg-sky-700 hover:animate-bounce rounded-4xl ml-11
          mt-4 px-2 py-2 text-white
        "
        type="button"
      >Order yours now!</button>
    </div>
    <div
      class="
        px-2 mx-2 p-10 text-center rounded-4xl sm:shadow-2xl sm:drop-shadow-gray-950
        sm:shadow-gray-950 justify-items-center sm:grid sm:grid-cols-3 sm:gap-2
        text-teal-400
      "
    >
      <div class="col-span-3 image_wrapper">
        <%# image_tag "DSC_3915.JPG", alt: "rod2", class: "rounded-4xl" %>
        <%= image_tag "DSC_3926.JPG", alt: "rod2", class: "rounded-4xl image_tag" %>
        <svg viewBox="0 0 400 600">
          <a href="../products/index.html.erb">
            <rect x="30" width="150" height="900" opacity="0" class="left-rod-rect"/>
          </a>
          <rect x="180" width="120" height="900" opacity="0" class="middle-rod-rect"/>
          <rect x="300" width="100" height="900" opacity="0" class="right-rod-rect"/>
        </svg>
        <p>Makes for An Excellent Gift for your Beloved Fisherman!</p>
      </div>
    </div>
  </body>
</html>
