<!doctype html>
<html>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css"/>
  <body class=" bg-sky-950">
    <div class="px-2 shadow-2xl shadow-gray-950 rounded-4xl p-10">
      <h1 class="text-blue-500 text-3xl font-bold">BentStyx Custom Rods</h1>
      <p class="text-teal-400 text-center italic text-sm font-light">About Me:
        <span class="font-extralight italic">
          I am retired and following my passion of fishing and craftsmanship to
          bring you the best fishing experience possible!</span></p>
      <button
        class="
          bg-sky-500 hover:mt-4 hover:bg-sky-700 hover:animate-bounce rounded-4xl px-4
          py-2 text-white
        "
        type="button"
      >Order yours now!</button>
    </div>
    <div
      class="
        p-1 text-center rounded-4xl shadow-2xl drop-shadow-gray-950 shadow-gray-950
        justify-items-center sm:grid sm:grid-cols-3 sm:gap-2 text-teal-400
      "
    >
      <div><img
          class="rounded-4xl"
          src="https://blackfinrods.com/cdn/shop/files/solo_angle-2-1500_1500x.png?v=1741884099"
          alt="rod1"
        >
        <p>Handcrafted</p>
      </div>
      <div class="col-span-2"><img
          class="rounded-4xl"
          src="https://majorleaguefishing.com/wp-content/uploads/2019/03/St.-Croix-Introduces-Two-New-RIP-N-CHATTER-RODS-1000x500.jpg"
          alt="rod2"
        >
        <p>Passion fueled perfection</p>
      </div>
      <div class="col-span-3">
        <img
          class="rounded-4xl"
          src="https://www.wired2fish.com/wp-content/uploads/2023/02/best-fishing-rods-2024-800x450.webp"
          alt="rod3"
        >
        <p>Makes for An Excellent Gift for your Beloved Fisherman!</p>
      </div>
    </div>
  </body>
</html>
