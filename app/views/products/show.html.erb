<!doctype html>
<html>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css"/>
  <body class="bg-gray-800">
    <div
      style="align-self: first baseline; display: flex; flex-direction: column; margin-left: auto; margin-right: auto;"
      class="
        px-2 mx-2 sm:shadow-2xl sm:shadow-gray-950 rounded-4xl p-10 text-center
      "
    >

      <button
        class="bg-gray-500 rounded-md text-white px-2"
        type="button"
        style="width: 45%; margin: auto;"
      >
        <%= link_to "Back to Home", root_path %>

      </button>
      <h1 class="font-semibold text-3xl text-gray-500"><%= @product.name %></h1>
      <div class="product-details">
        <div class="px-2 py-2 mx-2 text-gray-300 text-center">
          <%= image_tag @product.image_name, class: "rounded-4xl image_tag product_page_image" %>

          <p class="text-gray-400 text-center italic text-sm font-light"><strong>Price:</strong>
            <%= number_to_currency(@product.price) %></p>
          <p class="text-gray-400 text-center italic text-sm font-light"><%= @product.description %></p>
        </div>
      </div>
    </div>
  </body>
</html>
